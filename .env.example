# Copie para .env e preencha. O .env NÃO vai para o Git.
# Se essas variáveis já estiverem configuradas no Windows, as do Windows têm prioridade.

# Endereço do banco (só em produção; no seu computador usa localhost)
# DB_URL=jdbc:postgresql://host:5432/banco
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_do_postgres

# Chave do JWT em Base64 (gere com: openssl rand -base64 64)
JWT_SECRET=

# Usados só pela migration V6 (criação do admin). Hash BCrypt da senha.
ADMIN_EMAIL=
ADMIN_SENHA_HASH=

# Número da barbearia com DDI+DDD, só dígitos (botão "Enviar para a barbearia")
BARBEARIA_WHATSAPP=5581984920075

# Endereços do front que podem chamar a API (separe por vírgula)
CORS_ORIGENS=http://localhost:5173

# true só em produção, atrás do proxy do Railway (IP real do cliente no limite de tentativas)
CONFIAR_PROXY=false

# false em produção: esconde o Swagger (/swagger-ui.html)
SWAGGER_HABILITADO=true

# Avisos no Telegram (veja o README)
TELEGRAM_HABILITADO=false
TELEGRAM_TOKEN=
# IDs que recebem TODOS os avisos (ex.: dono), separados por vírgula
TELEGRAM_CHAT_IDS=
# Endereço público do painel (deixe vazio enquanto roda em localhost)
PAINEL_URL=

RECAPTCHA_HABILITADO=false
RECAPTCHA_SECRET=
